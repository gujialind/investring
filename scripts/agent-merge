#!/usr/bin/env bash
# agent-merge <feature>：把最新主干并入 agent/<feature>（冲突在工作中于自己领地内暴露和解决），然后推送分支。
# 开 PR 仍由 Agent 按 .github/PULL_REQUEST_TEMPLATE.md 完成；本脚本不合入任何分支——合入是维护者的决定。
set -euo pipefail
feature="${1:?usage: agent-merge <feature>}"
root=$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")
wt="$root/.qoder/worktrees/$feature"
[ -d "$wt" ] || { echo "agent-merge: 没有 worktree $wt（先跑 agent-spin）" >&2; exit 1; }
[ -z "$(git -C "$wt" status --porcelain)" ] || { echo "agent-merge: $wt 有未提交改动，先提交" >&2; exit 1; }
git -C "$wt" fetch --quiet origin main
git -C "$wt" merge --no-edit origin/main
git -C "$wt" push -u origin "agent/$feature"
echo "已把 origin/main 并入 agent/$feature 并推送。"
echo "下一步: gh pr create --base main --head agent/$feature（正文按 PR 模板附验证证据）"
