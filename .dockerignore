# Git
.git/
.gitignore
.gitattributes

# Node / Frontend (not needed for backend build)
frontend/
node_modules/
.next/
package-lock.json
package.json

# Python
__pycache__/
*.py[cod]
.venv/
.venv-openapi/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/

# Vendored deps (migrated away, may still exist locally)
backend/deps/
# Local wheel cache — 落在此处会被 `COPY backend/ .` 带进运行镜像层
backend/.packages/

# Tests (not needed in production image)
backend/tests/

# Coverage & test reports（本地生成物；`backend/` 下两项会被 `COPY backend/ .` 带进镜像）
.coverage
.coverage.*
coverage.xml
junit.xml

# Environment (secrets should not leak into image layers!)
.env
*.env
backend/.env

# IDE
.vscode/
.idea/
.trae/
.hermes/
.qwen/
.qoder/
.lingma/
.agents/
.apifox/
.codebuddy/
.mimosa/

# 本地工具脚手架 / 缓存
.dsh/
.playwright-cli/

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose*.yml
Dockerfile*

# Docs & specs (not runtime)
docs/
*.md
AGENTS.md

# CLI (not needed in backend image)
ir-cli/
backend/cli/

# DB files
*.db
*.sqlite3

# Logs
logs/
*.log
