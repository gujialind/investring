# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=investring

# Alternatively, you can use a full database URL
# DATABASE_URL=mysql+pymysql://user:password@host:port/dbname?charset=utf8mb4

# Security
# 必填：随机强密钥（≥32 字节），如 `openssl rand -hex 32`。
# 占位值会在启动校验中被拒绝（issue #255），复制本文件后必须替换。
SECRET_KEY=your-secret-key-change-in-production
TOKEN_EXPIRE_DAYS=7

# Tushare API
TUSHARE_TOKEN=your_tushare_token

# Application
DEBUG=True

# 业务时区（#746）：调度触发与「业务今天」计算的单一来源，默认 Asia/Shanghai
# TIMEZONE=Asia/Shanghai
